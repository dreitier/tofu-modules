{
  "uid": "traefik-clusters",
  "title": "Traefik (all clusters)",
  "tags": [
    "traefik",
    "ingress"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "Traefik of the dreitier cluster (traefik-internal, traefik-public) and Rancher's k3s – metrics from Prometheus, access logs from Loki (config/alloy/traefik-logs.alloy)",
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traefik_entrypoint_requests_total, cluster)",
          "refId": "V"
        },
        "definition": "label_values(traefik_entrypoint_requests_total, cluster)",
        "refresh": 2,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "namespace",
        "label": "Traefik",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traefik_entrypoint_requests_total{cluster=~\"$cluster\"}, namespace)",
          "refId": "V"
        },
        "definition": "label_values(traefik_entrypoint_requests_total{cluster=~\"$cluster\"}, namespace)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "entrypoint",
        "label": "Entrypoint",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traefik_entrypoint_requests_total{cluster=~\"$cluster\", namespace=~\"$namespace\", entrypoint!~\"metrics|traefik\"}, entrypoint)",
          "refId": "V"
        },
        "definition": "label_values(traefik_entrypoint_requests_total{cluster=~\"$cluster\", namespace=~\"$namespace\", entrypoint!~\"metrics|traefik\"}, entrypoint)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traefik_service_requests_total{cluster=~\"$cluster\", namespace=~\"$namespace\"}, service)",
          "refId": "V"
        },
        "definition": "label_values(traefik_service_requests_total{cluster=~\"$cluster\", namespace=~\"$namespace\"}, service)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
