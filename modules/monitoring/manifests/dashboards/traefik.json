    {
      "id": 10,
      "type": "heatmap",
      "title": "Latency distribution (entrypoints)",
      "description": "Requests per latency bucket (traefik_entrypoint_request_duration_seconds) for the selected Traefiks/entrypoints – darker = more requests. Requests above the largest bucket (long uploads, WebSockets, long polling) end up in the top row. Pick a single Traefik with the variable above to compare them.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (le) (increase(traefik_entrypoint_request_duration_seconds_bucket{cluster=~\"$cluster\", namespace=~\"$namespace\", entrypoint=~\"$entrypoint\"}[$__rate_interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "interval": ""
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 1,
        "yAxis": {
          "axisPlacement": "left",
          "unit": "s",
          "reverse": false
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "scale": "exponential",
          "exponent": 0.5,
          "fill": "dark-orange",
          "reverse": false,
          "steps": 64
        },
        "cellValues": {
          "unit": "short",
          "decimals": 0
        },
        "filterValues": {
          "le": 1e-09
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true,
          "showColorScale": false
        },
        "legend": {
          "show": true
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        },
        "showValue": "never"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      }
