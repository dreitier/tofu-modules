# Keycloak login secrets, read ephemerally – only the one the login method needs (the service account's entry
# doesn't exist before the first run of config/keycloak)
ephemeral "vault_kv_secret_v2" "keycloak_tofu" {
  count = var.keycloak_auth_method == "client_credentials" ? 1 : 0

  mount = var.keycloak_tofu_kv_mount
  name  = var.keycloak_tofu_kv_name
}

# Master admin password (bootstrap admin: generated by config/openbao-base, used by security/keycloak)
ephemeral "vault_kv_secret_v2" "keycloak_admin" {
  count = var.keycloak_auth_method == "password" ? 1 : 0

  mount = var.keycloak_admin_kv_mount
  name  = var.keycloak_admin_kv_name
}
